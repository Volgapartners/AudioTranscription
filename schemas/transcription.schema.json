{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volgapartners.com/schemas/transcription/v2",
  "title": "Transcription Output",
  "description": "Schema for validated transcription JSON files produced by the Volga Partners transcription workflow",
  "type": "object",
  "required": ["audio_name", "utterances"],
  "additionalProperties": false,
  "properties": {
    "audio_name": {
      "type": "string",
      "minLength": 1,
      "description": "Normalised audio name (extensions stripped, underscores replaced with #)"
    },
    "utterances": {
      "type": "array",
      "minItems": 1,
      "description": "Transcription utterances in chronological order",
      "items": {
        "type": "object",
        "required": [
          "speaker",
          "start_time",
          "end_time",
          "transcript",
          "non_speech_events",
          "language_attributes"
        ],
        "additionalProperties": false,
        "properties": {
          "speaker": {
            "type": "string",
            "pattern": "^speaker_\\d+$",
            "description": "Speaker identifier (e.g., speaker_01)"
          },
          "start_time": {
            "type": ["number", "null"],
            "description": "Start time in seconds"
          },
          "end_time": {
            "type": ["number", "null"],
            "description": "End time in seconds"
          },
          "transcript": {
            "type": "string",
            "description": "Transcribed text content"
          },
          "non_speech_events": {
            "type": "object",
            "required": ["emotions"],
            "additionalProperties": false,
            "properties": {
              "emotions": {
                "type": "string",
                "description": "Emotion label (e.g., neutral, happy, sad)"
              }
            }
          },
          "language_attributes": {
            "type": "object",
            "required": ["language", "locale", "accent"],
            "additionalProperties": false,
            "properties": {
              "language": {
                "type": "string",
                "minLength": 1,
                "description": "Human-readable language name (e.g., English, Arabic)"
              },
              "locale": {
                "type": "string",
                "description": "Locale code (e.g., en-US, ar-AR)"
              },
              "accent": {
                "type": "string",
                "description": "Accent descriptor (e.g., Standard English)"
              }
            }
          }
        }
      }
    }
  }
}
