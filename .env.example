# ============================================================
# Transcription Backend — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#
# Precedence: CLI flags > .env values > hardcoded defaults
# All values are optional.
# =====================================================add=======

# ---------------------
# Google OAuth
# ---------------------

# Path to Google OAuth credentials JSON (downloaded from GCP Console)
TRANSCRIBE_CREDENTIALS=./credentials.json

# Path to cache the OAuth token (auto-created after first login)
# TRANSCRIBE_TOKEN=./.token.json

# ---------------------
# Google Drive Folders
# ---------------------
# Accepts full Drive URLs or raw folder IDs.
# Examples:
#   https://drive.google.com/drive/folders/1ABCxyz...
#   https://drive.google.com/drive/u/0/folders/1ABCxyz...
#   1ABCxyz...  (raw folder ID)

# Client audio source folder (required)
TRANSCRIBE_SOURCE=

# Volga Drive folder for uploading templates (optional — skip to keep templates local)
TRANSCRIBE_VOLGA=

# Client delivery folder for uploading final JSON output (required)
TRANSCRIBE_DELIVERY=

# ---------------------
# Local Folder Input
# ---------------------
# Path to a local folder of audio files (bypasses all Google Drive operations).
# Folder must contain lang=xx/ subfolders with audio files.
# Example: TRANSCRIBE_LOCAL=./audio-files
TRANSCRIBE_LOCAL=

# ---------------------
# Project Settings
# ---------------------

# Project name (auto-generated as project_YYYY-MM-DD_HHMMSS if empty)
TRANSCRIBE_PROJECT_NAME=

# Base directory for all project workspaces
TRANSCRIBE_WORKSPACE=./workspace

# ---------------------
# Transcription
# ---------------------

# External transcription script/binary command
# Leave empty for manual mode (pauses for human transcription)
# Example: TRANSCRIBE_CMD=./scripts/transcribe.sh
TRANSCRIBE_CMD=

# ---------------------
# Deepgram AI Transcription
# ---------------------
# Set API key to enable Deepgram mode (auto-detected when present)
# Priority: --transcribe-cmd (script) > DEEPGRAM_API_KEY (AI) > manual
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# Deepgram model (default: nova-3)
DEEPGRAM_MODEL=nova-3

# Concurrent Deepgram API calls
DEEPGRAM_WORKERS=3

# Deepgram transcription options (all default to true except detect-language)
DEEPGRAM_DIARIZE=true
DEEPGRAM_PUNCTUATE=true
DEEPGRAM_SMART_FORMAT=true
DEEPGRAM_UTTERANCES=true
DEEPGRAM_DETECT_LANGUAGE=false

# Utterance split threshold in seconds
DEEPGRAM_UTT_SPLIT=0.8

# ---------------------
# Performance
# ---------------------

# Number of concurrent download/upload workers for Google Drive I/O
TRANSCRIBE_WORKERS=5

# ---------------------
# Logging
# ---------------------

# Enable DEBUG-level logging (true/false)
TRANSCRIBE_VERBOSE=false

# Force JSON log output instead of color-coded terminal output (true/false)
# Useful for piping to log aggregators or CI environments
TRANSCRIBE_JSON_LOG=false
